+/*
+ * Power-up as on the phone's own kernel: 1.8 V (GPIO 23) first, then 3.3 V (LDO28), then the reset pulse.
+ * The other order leaves SCL held low by the unpowered controller.
+ */
 static bool
+touch_equuleus_start(void)
+{
+	vm_offset_t vdd = ml_io_map(STFTS_VDD_PA, 0x1000);
+	uint8_t e[STFTS_EVT_BYTES] = {0};
+	int err = ETIMEDOUT;
+	if (!vdd) {
+		printf("SWEET TOUCH: GPIO23 mapping failed\n");
+		return false;
+	}
+	touch_gpio(tb->irq, 0, 3, 0, false, false);
+	touch_gpio(tb->sda, 0, 3, 0, false, false);
+	touch_gpio(tb->scl, 0, 3, 0, false, false);
+	touch_wr(vdd, 4u, (touch_rd(vdd, 4u) & ~2u) | 2u);
+	touch_wr(vdd, 0u, (touch_rd(vdd, 0u) & ~0x3ffu) | 0x200u);
+	touch_wait(10);
+	int rail = sweet_rpmh_vreg_enable("ldoa28", 3300);
+	printf("SWEET TOUCH: L28 3.3 V vote -> %d\n", rail);
+	if (rail) {
+		return false;
+	}
+	touch_gpio(tb->rst, 0, 3, 7, true, true);
+	touch_wait(10);
+	touch_gpio(tb->rst, 0, 3, 7, true, false);
+	touch_wait(10);
+	touch_gpio(tb->rst, 0, 3, 7, true, true);
+	touch_wait(200);
+	st.probing = true;
+	for (unsigned i = 0; err && i < 5; ++i) {
+		err = touch_read(STFTS_ADDR, STFTS_READ_EVENT, false, e, sizeof(e));
+		if (err) {
+			touch_wait(20);
+		}
+	}
+	st.probing = false;
+	printf("SWEET TOUCH: probe ST FTS at %#x: err=%d event=%02x\n", STFTS_ADDR, err, e[0]);
+	if (err) {
+		return false;
+	}
+	for (unsigned i = 0; e[0] != STFTS_EVT_READY && i < 100; ++i) {
+		if (e[0] == 0) {
+			touch_wait(10);
+		}
+		err = touch_read(STFTS_ADDR, STFTS_READ_EVENT, false, e, sizeof(e));
+		if (err) {
+			break;
+		}
+	}
+	int scan = stfts_start_scan();
+	printf("SWEET TOUCH: ST FTS ready=%d err=%d scan=%d\n", e[0] == STFTS_EVT_READY, err, scan);
+	if (scan) {
+		return false;
+	}
+	st.kind = TOUCH_ST_FTS;
+	return true;
+}
