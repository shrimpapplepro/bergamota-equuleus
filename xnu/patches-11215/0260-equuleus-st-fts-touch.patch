 /* Poco F1: NT36672A, powered with the panel. Reset only if it does not answer. */
+static int
+stfts_start_scan(void)
+{
+	const uint8_t cmd[3] = {STFTS_SCAN_MODE, 0x00, 0x01}; /* active scan, multi-touch */
+	return bb_xfer(STFTS_ADDR, cmd, sizeof(cmd), NULL, 0);
+}
+
+static int
+touch_st_fts(void)
+{
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	bool changed = false;
+	memcpy(x, st.x, sizeof(x));
+	memcpy(y, st.y, sizeof(y));
+	for (unsigned i = 0; i < STFTS_FIFO_DEPTH; ++i) {
+		uint8_t e[STFTS_EVT_BYTES];
+		int err = touch_read(STFTS_ADDR, STFTS_READ_EVENT, false, e, sizeof(e));
+		if (err) {
+			return err;
+		}
+		if (e[0] == 0) {
+			break;
+		}
+		if (e[0] == STFTS_EVT_READY) {
+			/* The controller reset itself: sensing is off and its contacts are gone. */
+			printf("SWEET TOUCH: ST FTS reset itself; restarting the scan\n");
+			changed |= mask != 0;
+			mask = 0;
+			err = stfts_start_scan();
+			if (err) {
+				return err;
+			}
+			continue;
+		}
+		if (e[0] != STFTS_EVT_ENTER && e[0] != STFTS_EVT_MOTION && e[0] != STFTS_EVT_LEAVE) {
+			continue;
+		}
+		unsigned id = e[1] >> 4, type = e[1] & 15u;
+		if (id >= TOUCH_MAX) {
+			continue;
+		}
+		uint32_t bit = 1u << id;
+		if (e[0] == STFTS_EVT_LEAVE || type < 1u || type > 3u) { /* finger, glove and stylus are contacts */
+			changed |= (mask & bit) != 0;
+			mask &= ~bit;
+			continue;
+		}
+		unsigned px = ((unsigned)(e[3] & 15u) << 8) | e[2];
+		unsigned py = ((unsigned)e[4] << 4) | (e[3] >> 4);
+		if (px >= tb->w || py >= tb->h) {
+			continue; /* off the panel: a corrupt read */
+		}
+		x[id] = (int)px;
+		y[id] = (int)py;
+		mask |= bit;
+		changed = true;
+	}
+	if (changed) {
+		touch_report(mask, x, y);
+	}
+	return 0;
+}
