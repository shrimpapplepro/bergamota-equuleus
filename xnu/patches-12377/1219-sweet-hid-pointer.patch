diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -412,6 +412,27 @@
 
 static SweetHIDButtons *gSweetButtons;
 static SweetHIDTouch *gSweetTouch;
+
+/*
+ * Patch 1219: a relative pointing device (trackpad/mouse). WindowServer accepts a relative pointer with no
+ * display association (unlike a digitizer, which needs a displayUUID), so this delivers cursor motion and clicks
+ * to the macOS UI. Driven by sweet_hid_pointer(dx, dy, buttons) from the touch panel (trackpad emulation) or the
+ * kern.sweet_pointer sysctl (bsd/dev/sweet_reboot.c) for testing over SSH. buttons bit0 = left.
+ */
+class SweetHIDPointer : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDPointer);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void move(int dx, int dy, unsigned buttons);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_GenericDesktop; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_GD_Mouse; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 3; }
+private:
+	unsigned fButtons;
+};
+OSDefineMetaClassAndStructors(SweetHIDPointer, IOHIDEventService);
+static SweetHIDPointer *gSweetPointer;
 
 bool
 SweetHIDButtons::start(IOService *provider)
@@ -678,5 +699,40 @@
 {
 	if (gSweetTouch) {
 		gSweetTouch->touch(finger, down != 0, x, y);
+	}
+}
+
+bool
+SweetHIDPointer::start(IOService *provider)
+{
+	if (!IOHIDEventService::start(provider)) {
+		return false;
 	}
+	setProperty("HIDPointerAccelerationType", "HIDMouseAcceleration");
+	gSweetPointer = this;
+	registerService();
+	IOLog("SWEET HID: pointer (relative mouse) registered\n");
+	return true;
 }
+
+/* Relative move by (dx, dy) device units and set the button state (bit0 = left). */
+void
+SweetHIDPointer::move(int dx, int dy, unsigned buttons)
+{
+	const unsigned old = fButtons;
+	fButtons = buttons & 0x7;
+	IOHIDEvent *event = IOHIDEvent::relativePointerEvent(mach_absolute_time(), dx, dy, 0, fButtons, old, 0);
+	if (event) {
+		dispatchEvent(event);
+		event->release();
+	}
+}
+
+/* dx, dy: relative motion in device units; buttons: bit0 left, bit1 right, bit2 middle. */
+extern "C" void
+sweet_hid_pointer(int dx, int dy, unsigned buttons)
+{
+	if (gSweetPointer) {
+		gSweetPointer->move(dx, dy, buttons);
+	}
+}
