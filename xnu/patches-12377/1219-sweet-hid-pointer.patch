diff --git a/bsd/dev/sweet_reboot.c b/bsd/dev/sweet_reboot.c
--- a/bsd/dev/sweet_reboot.c
+++ b/bsd/dev/sweet_reboot.c
@@ -602,7 +602,51 @@
 SYSCTL_PROC(_kern, OID_AUTO, sweet_bootwd,
     CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sr_bootwd_sysctl, "I",
     "Boot watchdog: seconds left (0 = off); write 0 to disarm, N to check for the TCP listener in N s");
+
+/*
+ * Patch 1219: kern.sweet_pointer = "DX DY BUTTONS" posts one relative pointer (trackpad) move/click through the
+ * SweetHIDPointer HID service (iokit/Kernel/arm/hid/SweetHID.cpp), so the cursor can be driven over SSH for testing
+ * before the touch panel is wired to it. BUTTONS bit0 = left, bit1 = right, bit2 = middle.
+ */
+extern void sweet_hid_pointer(int dx, int dy, unsigned buttons);
+
+static int
+sweet_pointer_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[48] = "";
+	int error = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	int v[3] = {0, 0, 0};
+	const char *p = buf;
+	for (int i = 0; i < 3; i++) {
+		while (*p == ' ' || *p == '\t') {
+			p++;
+		}
+		int sign = 1;
+		if (*p == '-') {
+			sign = -1;
+			p++;
+		} else if (*p == '+') {
+			p++;
+		}
+		int n = 0;
+		while (*p >= '0' && *p <= '9') {
+			n = n * 10 + (*p - '0');
+			p++;
+		}
+		v[i] = sign * n;
+	}
+	sweet_hid_pointer(v[0], v[1], (unsigned)v[2]);
+	return 0;
+}
 
+SYSCTL_PROC(_kern, OID_AUTO, sweet_pointer,
+    CTLTYPE_STRING | CTLFLAG_WR | CTLFLAG_LOCKED, 0, 0, sweet_pointer_sysctl, "A",
+    "Post a relative pointer event: write \"DX DY BUTTONS\" (buttons bit0=left)");
+
