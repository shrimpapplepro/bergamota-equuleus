+/*
+ * Patch 0261: the controller stopped reporting after hours of use (bus answered, FIFO always empty). Counters
+ * for the cause, and the recovery state the touch thread acts on (stfts_watchdog).
+ */
+#define STFTS_EVT_STATUS 0x43u
+#define STFTS_EVT_ERROR  0xf3u
+static struct {
+	uint64_t last_event;          /* mach time of the last non-empty event */
+	uint64_t last_kick, last_reinit, last_stats;
+	unsigned ready, enter, motion, leave, status, error, other;
+	unsigned empty_irq;           /* consecutive passes: IRQ low but the FIFO read empty */
+	unsigned kicks, reinits;
+	uint8_t last_error[STFTS_EVT_BYTES];
+	volatile bool wake_req;       /* power key pressed (sweet_keys.c) */
+	volatile bool reinit_req;
+} sf;
+
+static uint64_t
+stfts_secs(unsigned s)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime((uint64_t)s * NSEC_PER_SEC, &t);
+	return t;
 }
 
