+/*
+ * Patch 0261: what the controller looks like when touch has gone quiet. Chip ID through the FTM5 hardware
+ * register read (0xfa + 32-bit address 0x20000000, one dummy byte, then 0x36 0x39), the bus lines and the counters.
+ */
+static void
+stfts_report(const char *why)
+{
+	const uint8_t cmd[5] = {0xfa, 0x20, 0x00, 0x00, 0x00};
+	uint8_t id[3] = {0, 0, 0};
+	int err = bb_xfer(STFTS_ADDR, cmd, sizeof(cmd), id, sizeof(id));
+	uint64_t idle = (mach_absolute_time() - sf.last_event) / stfts_secs(1);
+	printf("SWEET TOUCH: ST FTS %s: id err=%d %02x %02x %02x sda=%d scl=%d irq=%d idle=%llus active=%#x "
+	    "ev ready=%u enter=%u motion=%u leave=%u status=%u error=%u other=%u kicks=%u reinits=%u clears=%u "
+	    "last-error=%02x %02x %02x %02x\n",
+	    why, err, id[0], id[1], id[2], bb_get(tb->sda), bb_get(tb->scl),
+	    (int)(touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)) & 1u), idle, st.active,
+	    sf.ready, sf.enter, sf.motion, sf.leave, sf.status, sf.error, sf.other, sf.kicks, sf.reinits, bb_clears,
+	    sf.last_error[0], sf.last_error[1], sf.last_error[2], sf.last_error[3]);
+}
