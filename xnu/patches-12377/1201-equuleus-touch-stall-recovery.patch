+/* Patch 0261: rail vote, bus clear, reset pulse, wait for READY, scan on. Contacts are released first. */
+static void
+stfts_reinit(const char *why)
+{
+	uint8_t e[STFTS_EVT_BYTES] = {0};
+	int err = 0;
+	sf.reinits++;
+	sf.last_reinit = mach_absolute_time();
+	stfts_report(why);
+	if (st.active) {
+		touch_report(0, st.x, st.y);
+	}
+	int rail = sweet_rpmh_vreg_enable("ldoa28", 3300);
+	(void)bb_bus_clear();
+	touch_gpio(tb->rst, 0, 3, 7, true, false);
+	touch_wait(10);
+	touch_gpio(tb->rst, 0, 3, 7, true, true);
+	touch_wait(200);
+	bool ready = false;
+	for (unsigned i = 0; !ready && i < 100; ++i) {
+		err = touch_read(STFTS_ADDR, STFTS_READ_EVENT, false, e, sizeof(e));
+		ready = !err && e[0] == STFTS_EVT_READY;
+		if (!ready && (err || e[0] == 0)) {
+			touch_wait(10);
+		}
+	}
+	int scan = stfts_start_scan();
+	sf.empty_irq = 0;
+	sf.last_event = sf.last_kick = mach_absolute_time();
+	printf("SWEET TOUCH: ST FTS re-init (%s, #%u): rail=%d ready=%d err=%d scan=%d\n",
+	    why, sf.reinits, rail, ready, err, scan);
+}
+
+/*
+ * Patch 0261, once per touch-thread pass on the Mi 8 Pro:
+ *  - power key down and no event for 3 s: full re-init (the user is about to touch; a missed READY, a stopped
+ *    scan or a confused controller are all cleared by the reset);
+ *  - every 5 s without a finger down and without events: bus check (bb_start clears a held SDA) and scan mode
+ *    re-sent; harmless when it is already scanning;
+ *  - the IRQ/FIFO disagreement from touch_st_fts: full re-init, at most once every 30 s;
+ *  - every 30 minutes: one stats line.
+ */
+static void
+stfts_watchdog(void)
+{
+	uint64_t now = mach_absolute_time();
+	if (sf.wake_req) {
+		sf.wake_req = false;
+		if (!st.active && now - sf.last_event > stfts_secs(3)) {
+			stfts_reinit("power key");
+			return;
+		}
+	}
+	if (sf.reinit_req) {
+		sf.reinit_req = false;
+		if (sf.last_reinit == 0 || now - sf.last_reinit > stfts_secs(30)) {
+			stfts_reinit("IRQ low over an empty FIFO");
+			return;
+		}
+	}
+	if (!st.active && now - sf.last_event > stfts_secs(5) && now - sf.last_kick > stfts_secs(5)) {
+		sf.last_kick = now;
+		sf.kicks++;
+		int err = stfts_start_scan();
+		if (err && (sf.kicks % 60u) == 1u) {
+			printf("SWEET TOUCH: ST FTS scan re-send err=%d\n", err);
+		}
+	}
+	if (now - sf.last_stats > stfts_secs(1800)) {
+		sf.last_stats = now;
+		stfts_report("stats");
+	}
 }
 
