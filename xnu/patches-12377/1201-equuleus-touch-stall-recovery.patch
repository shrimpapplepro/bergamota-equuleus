+/*
+ * Mi 8 Pro (patch 0261): a slave left mid-byte holds SDA low. The bit-banged master never checks the line it
+ * drives high, so every later read "succeeds" with zeros: an empty event FIFO, no errors, dead touch.
+ * Bus clear (I2C spec 3.1.16): clock SCL until the slave lets SDA go (at most 9 pulses), then START + STOP.
+ */
+static unsigned bb_clears;
 
+static void
+bb_stop(void);
+
 static bool
+bb_bus_clear(void)
+{
+	bb_line(tb->sda, true);
+	if (!bb_scl_high() || bb_get(tb->sda)) {
+		return false;
+	}
+	unsigned pulses = 0;
+	while (pulses < 9 && !bb_get(tb->sda)) {
+		bb_line(tb->scl, false);
+		delay(BB_HALF_US);
+		(void)bb_scl_high();
+		pulses++;
+	}
+	bb_stop(); /* SDA low while SCL is high (START), then released (STOP) */
+	bb_clears++;
+	static uint64_t last_log;
+	uint64_t now = mach_absolute_time(), minute;
+	nanoseconds_to_absolutetime(60ull * NSEC_PER_SEC, &minute);
+	if (last_log == 0 || now - last_log >= minute) {
+		printf("SWEET TOUCH: SDA held low by the slave; bus cleared after %u clocks (sda=%d, %u clears)\n",
+		    pulses, bb_get(tb->sda), bb_clears);
+		last_log = now;
+	}
+	return true;
+}
+
+static bool
 bb_start(void)
 {
 	bb_line(tb->sda, true);
 	if (!bb_scl_high()) {
 		return false;
 	}
+	if (tb == &touch_equuleus && !bb_get(tb->sda) && bb_bus_clear()) {
+		bb_line(tb->sda, true);
+		if (!bb_scl_high()) {
+			return false;
+		}
+	}
 	bb_line(tb->sda, false);
 	delay(BB_HALF_US);
 	bb_line(tb->scl, false);
