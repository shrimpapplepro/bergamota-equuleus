diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -40,6 +40,7 @@
 #include <arm64/instructions.h>
 #include <arm64/sweet_fjcvtzs.h>
 #include <arm64/sweet_pacemu.h>
+#include <arm64/sweet_v8emu.h>
 
 #include <kern/debug.h>
 #include <kern/exc_guard.h>
@@ -1314,6 +1315,130 @@
 		task_t task = current_task();
 		void *bsd_info = get_bsdtask_info(task);
 		printf("SWEET: emulating %s 0x%08x at pc=0x%llx in %s[%d] (%llu so far)\n", sweet_pac_class_name(in.cls),
+		    instr, (unsigned long long)pc, bsd_info ? proc_name_address(bsd_info) : "?", task_pid(task),
+		    (unsigned long long)n);
+	}
+	return true;
+}
+
+/*
+ * SWEET (patch 1212): emulate the ARMv8.3-8.6 integer instructions that macOS 27's userland
+ * uses unconditionally and SDM845's Kryo 385 lacks (osfmk/arm64/sweet_v8emu.h: LRCPC2
+ * LDAPUR/STLUR, DotProd SDOT/UDOT, FlagM, SB, SHA3). LDAPUR/STLUR keep their ordering with
+ * a barrier after the load / before the store, and aligned 4/8-byte accesses stay single-copy
+ * atomic (copyin/copyout_atomic). A fault raises the SIGSEGV the instruction would have.
+ */
+static int
+sweet_v8_load(void *ctx __unused, uint64_t addr, unsigned size, uint64_t *val)
+{
+	const user_addr_t ua = (user_addr_t)VM_USER_STRIP_TBI(addr);
+	int err;
+
+	*val = 0;
+	if (size == 8 && (ua & 7) == 0) {
+		err = copyin_atomic64(ua, val);
+	} else if (size == 4 && (ua & 3) == 0) {
+		uint32_t w = 0;
+		err = copyin_atomic32(ua, &w);
+		*val = w;
+	} else {
+		err = copyin(ua, (char *)val, size);
+	}
+	__asm__ volatile ("dmb ish" ::: "memory");      /* acquire: later accesses stay after this load */
+	return err;
+}
+
+static int
+sweet_v8_store(void *ctx __unused, uint64_t addr, unsigned size, uint64_t val)
+{
+	const user_addr_t ua = (user_addr_t)VM_USER_STRIP_TBI(addr);
+
+	__asm__ volatile ("dmb ish" ::: "memory");      /* release: earlier accesses complete first */
+	if (size == 8 && (ua & 7) == 0) {
+		return copyout_atomic64(val, ua);
+	}
+	if (size == 4 && (ua & 3) == 0) {
+		return copyout_atomic32((uint32_t)val, ua);
+	}
+	return copyout((const void *)&val, ua, size);   /* little-endian: the low bytes */
+}
+
+static bool
+sweet_emulate_v8(arm_saved_state_t *state, uint32_t instr)
+{
+	static uint32_t sweet_v8_logged[SWEET_V8C_COUNT];
+	static uint64_t sweet_v8_count[SWEET_V8C_COUNT];        /* statistics: racy on purpose */
+	const unsigned cls = sweet_v8_classify(instr);
+	thread_t thread = current_thread();
+	arm_neon_saved_state64_t *ns64 = NULL;
+	struct sweet_v8_cpu cpu;
+	uint64_t fault_addr = 0;
+
+	if (cls == SWEET_V8C_NONE) {
+		return false;
+	}
+	cpu.written_x = 0;
+	cpu.written_v = 0;
+	cpu.written_nzcv = false;
+	if (sweet_v8_class_uses_neon(cls)) {
+		arm_neon_saved_state_t *ns = thread->machine.uNeon;
+		if (ns == NULL || !is_neon_saved_state64(ns)) {
+			return false;
+		}
+		ns64 = neon_state64(ns);
+		for (unsigned r = 0; r < 32; r++) {
+			cpu.v[r][0] = (uint64_t)ns64->v.q[r];
+			cpu.v[r][1] = (uint64_t)(ns64->v.q[r] >> 64);
+		}
+	}
+	for (unsigned i = 0; i < 29; i++) {
+		cpu.x[i] = (uint64_t)get_saved_state_reg(state, i);
+	}
+	cpu.x[29] = (uint64_t)get_saved_state_fp(state);
+	cpu.x[30] = (uint64_t)get_saved_state_lr(state);
+	cpu.sp = (uint64_t)get_saved_state_sp(state);
+	cpu.nzcv = get_saved_state_cpsr(state) & SWEET_V8_NZCV;
+	const uint64_t pc = (uint64_t)get_saved_state_pc(state);
+
+	thread->machine.recover_esr = 0;
+	thread->machine.recover_far = 0;
+	switch (sweet_v8_execute(instr, cls, &cpu, sweet_v8_load, sweet_v8_store, NULL, &fault_addr)) {
+	case SWEET_V8_DONE:
+		break;
+	case SWEET_V8_FAULT:
+		sweet_pac_fault(state, fault_addr);
+	default:
+		return false;
+	}
+
+	for (uint32_t m = cpu.written_x; m != 0; m &= m - 1) {
+		const unsigned r = (unsigned)__builtin_ctz(m);
+		if (r < 29) {
+			set_saved_state_reg(state, r, (register_t)cpu.x[r]);
+		} else if (r == 29) {
+			set_saved_state_fp(state, (register_t)cpu.x[29]);
+		} else if (r == 30) {
+			set_user_saved_state_lr(state, (register_t)cpu.x[30]);
+		}
+	}
+	if (ns64 != NULL) {
+		for (uint32_t m = cpu.written_v; m != 0; m &= m - 1) {
+			const unsigned r = (unsigned)__builtin_ctz(m);
+			ns64->v.q[r] = ((__uint128_t)cpu.v[r][1] << 64) | cpu.v[r][0];
+		}
+	}
+	if (cpu.written_nzcv) {
+		set_saved_state_cpsr(state, (get_saved_state_cpsr(state) & ~SWEET_V8_NZCV) | (cpu.nzcv & SWEET_V8_NZCV));
+	}
+	set_saved_state_pc(state, (register_t)(pc + 4));
+
+	/* the first four of each class, then every power of two from 1024 on, with the process */
+	const uint64_t n = ++sweet_v8_count[cls];
+	if ((sweet_v8_logged[cls] < 4 && os_atomic_inc_orig(&sweet_v8_logged[cls], relaxed) < 4) ||
+	    (n >= 1024 && (n & (n - 1)) == 0)) {
+		task_t task = current_task();
+		void *bsd_info = get_bsdtask_info(task);
+		printf("SWEET: emulating %s 0x%08x at pc=0x%llx in %s[%d] (%llu so far)\n", sweet_v8_class_name(cls),
 		    instr, (unsigned long long)pc, bsd_info ? proc_name_address(bsd_info) : "?", task_pid(task),
 		    (unsigned long long)n);
 	}
@@ -1415,6 +1540,15 @@
 	}
 
 	/*
+	 * sweetarm64e=1 (patch 1212): an ARMv8.3-8.6 integer instruction this CPU lacks
+	 * (LRCPC2, DotProd, FlagM, SB, SHA3; macOS 27 userland): emulate it.
+	 */
+	if (PSR64_IS_USER64(get_saved_state_cpsr(state)) && sweet_arm64e_enabled() &&
+	    sweet_emulate_v8(state, instr)) {
+		return;
+	}
+
+	/*
 	 * Check for GDB breakpoint via illegal opcode.
 	 */
 	if (IS_ARM_GDB_TRAP(instr)) {
