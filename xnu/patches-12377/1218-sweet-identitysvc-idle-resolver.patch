diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -1084,3 +1084,34 @@
 }
 
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/*
+ * Patch 1218: identitysvc (syscall 293) without CONFIG_EXT_RESOLVER (patch 0057 dropped it for iOS). macOS 27's
+ * opendirectoryd registers as the kernel's identity resolver (KAUTH_EXTLOOKUP_REGISTER) and then loops on
+ * KAUTH_EXTLOOKUP_WORKER | RESULT waiting for requests; ENOSYS (1212) made that loop spin at 100 % CPU. Here:
+ * register / deregister / cache calls succeed (cache sizes read as 0), and a worker call sleeps until a signal,
+ * as the real one does while no lookup is pending (this kernel never submits any).
+ */
+#if !CONFIG_EXT_RESOLVER
+#include <sys/sysproto.h>
+#include <sys/kauth.h>
+
+static int sweet_identitysvc_chan;
+
+int
+sweet_identitysvc(__unused struct proc *p, struct sweet_identitysvc_args *uap, __unused int32_t *retval)
+{
+	const int op = uap->opcode;
+
+	if (op & (KAUTH_EXTLOOKUP_WORKER | KAUTH_EXTLOOKUP_RESULT)) {
+		/* no lookups are ever submitted: wait like an idle resolver thread, until a signal */
+		int error = tsleep(&sweet_identitysvc_chan, PCATCH | PUSER, "identitysvc", 0);
+		return error ? error : EINTR;
+	}
+	if (op == KAUTH_GET_CACHE_SIZES && uap->message != USER_ADDR_NULL) {
+		uint32_t sz[2] = {0, 0};    /* struct kauth_cache_sizes { kcs_group_size, kcs_id_size } */
+		return copyout(sz, uap->message, sizeof(sz));
+	}
+	return 0;                   /* REGISTER, DEREGISTER, SET_CACHE_SIZES, CLEAR_CACHES */
+}
+#endif /* !CONFIG_EXT_RESOLVER */
