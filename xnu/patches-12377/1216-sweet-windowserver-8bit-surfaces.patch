+
+/*
+ * Patch 1216: macOS 27's CoreAnimation gives the display surfaces of WindowServer the 10-bit format '&BGA'
+ * (0x26424741, 4 bytes per pixel); SkyLight's software compositor only renders into 8-bit formats ("Unimplemented
+ * pixel format of %i used in WSCompositeDestinationCreateWithIOSurface." -> abort) and the panel scans BGRA anyway.
+ * WindowServer's '&BGA' surfaces are recorded as BGRA. Boot-arg sweetsurf8=0: off.
+ */
+#define SWEET_FORMAT_ARGB2101010_EXT    0x26424741u     /* '&BGA' */
+static bool
+sweet_surface_wants_8bit(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		int v = 1;
+		(void)PE_parse_boot_argn("sweetsurf8", &v, sizeof(v));
+		on = v ? 1 : 0;
+	}
+	if (!on) {
+		return false;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	return strcmp(name, "WindowServer") == 0;
 }
 
 /* Geometry from the creation properties (IOSurface.h keys). */
