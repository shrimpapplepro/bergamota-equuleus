 	s->pixelFormat = sweet_dict_u32(props, "IOSurfacePixelFormat", 0);
+	if (s->pixelFormat == SWEET_FORMAT_ARGB2101010_EXT && s->bytesPerElement == 4 && sweet_surface_wants_8bit()) {
