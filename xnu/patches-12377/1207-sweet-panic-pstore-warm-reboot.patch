+/*
+ * 1207: the paniclog is complete (kPEPanicDiagnosticsDone, also kPEPanicRestartCPU as a fallback).
+ * Once per panic. Returns only for sweetpanic=off or when nothing reset the SoC.
+ */
+void
+sweet_reboot_panic_done(void)
+{
+	char line[96];
+
+	sr_in_panic = true;
+	if (sr_panic_handled || !sr_ready) {
+		return;
+	}
+	sr_panic_handled = true;
+	sr_pstore_write();
+	if (sr_panic_mode < 0) {
+		sr_screen(sr_pstore ? "\nSWEET PANIC: log in pstore; sweetpanic=off, staying here\n" : "\n");
+		return;
+	}
+	snprintf(line, sizeof(line), "\nSWEET PANIC: log %s; reset to %s in %d s\n",
+	    sr_pstore ? "saved to pstore (LineageOS /sys/fs/pstore)" : "not saved", sr_name(sr_panic_mode), sr_panic_wait);
+	sr_screen(line);
+	for (int i = 0; i < sr_panic_wait; i++) {
+		delay(1000 * 1000);
+	}
+	sr_reset(sr_panic_mode, true);
+}
