+		return FALSE;
+	}
+	if (SWEET_PRAM_PA < ba->physBase + ba->memSize && ba->physBase < SWEET_PRAM_PA + SWEET_PRAM_SIZE) {
+		return FALSE;
+	}
+	gPanicBase = ml_io_map_wcomb(SWEET_PRAM_PA, SWEET_PRAM_SIZE);
+	if (!gPanicBase) {
+		return FALSE;
+	}
