+/*
+ * sweet: no iBoot, so the ADT has no "pram" and gPanicBase stays 0. Then panic_info is NULL and
+ * SavePanicInfo() spins forever right after the first panic line: no paniclog, no backtraces, no
+ * kPEPanicDiagnosticsDone, no restart. Fallback panic region: 512 KiB of DRAM that is not kernel
+ * RAM and that a warm reset keeps, inside the Linux ramoops carve-out of the Qualcomm phones
+ * (ramoops@b0000000, 4 MiB; LineageOS on the Mi 8 Pro: six 256 KiB dmesg records first, so this
+ * is records 1-2; record 0 at 0xb0000000 is where bsd/dev/sweet_reboot.c puts the pstore copy).
+ * Only used when the range is outside the kernel's RAM (sweet itself runs from 0xb0000000).
+ * Boot-arg sweetpram=0: off (old behaviour).
+ */
+#define SWEET_PRAM_PA   0xb0040000ULL
+#define SWEET_PRAM_SIZE 0x80000u
+
+static boolean_t
+sweet_pram_fallback(void)
+{
+	uint32_t on = 1;
+	boot_args *ba = (boot_args *)PE_state.bootArgs;
