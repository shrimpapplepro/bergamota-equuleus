+/* pstore record writer: data after the 12-byte persistent_ram_buffer header, byte at a time (write-combined). */
+static uint32_t sr_ps_len;
+
+static void
+sr_ps_put(const char *s, uint32_t n)
+{
+	while (n-- && sr_ps_len < SR_PSTORE_SIZE - SR_PSTORE_HDR) {
+		char c = *s++;
+		if (c) {
+			sr_pstore[SR_PSTORE_HDR + sr_ps_len++] = (uint8_t)c;
+		}
+	}
+}
+
+static void
+sr_ps_str(const char *s)
+{
+	sr_ps_put(s, (uint32_t)strlen(s));
+}
+
+static uint32_t
+sr_ps_room(void)
+{
+	return SR_PSTORE_SIZE - SR_PSTORE_HDR - sr_ps_len;
+}
+
+/* A region of the panic region (offset/length from the embedded panic header), bounded. */
+static void
+sr_ps_panic_part(const char *title, uint32_t off, uint32_t len, uint32_t max)
+{
+	if (!off || !len || off >= gPanicSize) {
+		return;
+	}
+	if (len > gPanicSize - off) {
+		len = gPanicSize - off;
+	}
+	if (len > max) {
+		len = max;
+	}
+	sr_ps_str(title);
+	sr_ps_put((const char *)gPanicBase + off, len);
+}
+
+/*
+ * Linux ramoops dmesg record 0: "====sec.nsec-D\n" (ramoops_read_kmsg_hdr: D = not compressed),
+ * then text. Header written last: sig, start = size = length (persistent_ram_save_old then copies
+ * data[0..length)).
+ */
+static void
+sr_pstore_write(void)
+{
+	char line[160];
+	uint64_t now = mach_absolute_time(), ns = 0;
+
+	if (!sr_pstore) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now, &ns);
+	sr_ps_len = 0;
+	sr_ps_str("====0.0-D\n");
+	snprintf(line, sizeof(line), "SWEET PANIC: xnu panic at %llu.%03llu s uptime, saved by sweet_reboot.c (patch 1207)\n",
+	    ns / 1000000000ull, (ns / 1000000ull) % 1000ull);
+	sr_ps_str(line);
+	sr_ps_str("boot-args: ");
+	sr_ps_str(PE_boot_args());
+	sr_ps_str("\n");
+	struct embedded_panic_header *ph = panic_info;
+	if (gPanicBase && ph && ph->eph_magic == EMBEDDED_PANIC_MAGIC) {
+		sr_ps_panic_part("\n--- paniclog ---\n", ph->eph_panic_log_offset, ph->eph_panic_log_len, 160u * 1024u);
+		sr_ps_panic_part("\n--- other log ---\n", ph->eph_other_log_offset, ph->eph_other_log_len, 16u * 1024u);
+	} else {
+		sr_ps_str("\n(no paniclog: no panic region)\n");
+	}
+	struct msgbuf *mb = msgbufp;
+	if (mb && mb->msg_magic == MSG_MAGIC && mb->msg_size > 0 && mb->msg_bufc && sr_ps_room() > 64) {
+		sr_ps_str("\n--- console tail (msgbuf) ---\n");
+		uint32_t size = (uint32_t)mb->msg_size, x = (uint32_t)mb->msg_bufx % size;
+		uint32_t want = sr_ps_room() - 1;
+		if (want > size) {
+			want = size;
+		}
+		uint32_t at = (x + size - want) % size;
+		for (uint32_t i = 0; i < want && sr_ps_room() > 1; i++) {
+			sr_ps_put(&mb->msg_bufc[(at + i) % size], 1);
+		}
+	}
+	sr_ps_str("\n");
+	__asm__ volatile ("dsb sy" ::: "memory");
+	volatile uint32_t *hdr = (volatile uint32_t *)(void *)sr_pstore;
+	hdr[1] = sr_ps_len;
+	hdr[2] = sr_ps_len;
+	hdr[0] = SR_PSTORE_SIG;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
