+	 * rest), only for what the device has acknowledged.
+	 */
+	int flush = sweet_ufs_flush_final();
+	printf("SWEET REBOOT: UFS cache flush -> %d%s\n", flush, flush == EBUSY ? " (busy, skipped)" : "");
+	if (!sr_ready) {
+		return -1;
+	}
+	sr_reset(sr_override >= 0 ? sr_override : sr_bootarg, false);
 	return -1;
 }
