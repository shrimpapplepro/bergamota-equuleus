+/*
+ * Patch 1213: kern.sweet_syserr_names (root, string): read = the traced process names; write = trace these
+ * instead ("-" = off) and start counting from 0 again, so a daemon can be traced without a reboot.
+ */
+static int
+sweet_syserr_names_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	char buf[sizeof(sweet_syserr_names)];
+	strlcpy(buf, sweet_syserr_names, sizeof(buf));
+	int error = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	size_t n = strlen(buf);
+	while (n && (buf[n - 1] == '\n' || buf[n - 1] == ' ')) {
+		buf[--n] = 0;
+	}
+	strlcpy(sweet_syserr_names, buf, sizeof(sweet_syserr_names));
+	sweet_syserr_state = (sweet_syserr_names[0] == '-') ? 1 : 2;
+	os_atomic_store(&sweet_syserr_count, 0, relaxed);
+	printf("SWEET ERR: tracing \"%s\" (sysctl), %d lines max\n", sweet_syserr_names, SWEET_SYSERR_MAX);
+	return 0;
+}
 
+SYSCTL_PROC(_kern, OID_AUTO, sweet_syserr_names, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sweet_syserr_names_sysctl, "A", "Failed-syscall tracer: comma separated process names, * = all, - = off");
