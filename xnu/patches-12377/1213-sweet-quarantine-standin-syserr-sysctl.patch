+/*
+ * Patch 1213: a policy named "Quarantine" for userland's __mac_syscall("Quarantine", ...). macOS ships
+ * Quarantine.kext; without it the call fails with ENOPOLICY and macOS 27's cfprefsd exits 254 right after
+ * op 87 (every `defaults`/CFPreferences user then waits forever). Nothing is quarantined here: every op
+ * answers 0 without writing anything back; each op is logged once. iOS userland never calls it.
+ */
+static uint64_t sweet_qtn_ops_seen[4];
+
+static int
+sweet_qtn_syscall(struct proc *p, int call, user_addr_t arg)
+{
+#pragma unused(arg)
+	if (call >= 0 && call < 256 && !(sweet_qtn_ops_seen[call / 64] & (1ULL << (call % 64)))) {
+		sweet_qtn_ops_seen[call / 64] |= 1ULL << (call % 64);
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET QTN: %s __mac_syscall(\"Quarantine\", %d) -> 0 (stand-in)\n", name, call);
+	}
+	return 0;
+}
 
+static const struct mac_policy_ops sweet_qtn_mac_ops = {
+	.mpo_policy_syscall = sweet_qtn_syscall,
+};
+
+static struct mac_policy_conf sweet_qtn_mac_conf = {
+	.mpc_name = "Quarantine",
+	.mpc_fullname = "SWEET Quarantine userland interface stand-in",
+	.mpc_ops = &sweet_qtn_mac_ops,
+};
+
+static mac_policy_handle_t sweet_qtn_mac_handle;
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void sweet_amfi_policy_register(void);
 
