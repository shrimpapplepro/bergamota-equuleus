+// Version 5 can map one PPID to several APIDs; the first that answers a read for this EE is the one used.
+uint16_t pmbFindApid(ButtonState &b, uint16_t ppid, uint16_t probe, uint8_t &value) {
+    for (unsigned n = 0; n < PMB_APID_COUNT; n++) {
+        const uint32_t map = rd32(b.core.va, PMB_REG_APID_MAP(n));
+        if (!map || PMB_MAP_PPID(map) != ppid) continue;
+        ++b.mapped;
+        uint32_t status = 0;
+        if (pmbRead(b, static_cast<uint16_t>(n), probe, value, status)) return static_cast<uint16_t>(n);
+        b.lastStatus = status;
+    }
+    return PMB_NO_APID;
