+    size_t copied = 0;
+    OSData *seed = OSDynamicCast(OSData, node->getProperty("unique-chip-id"));
+    if (seed && seed->getLength() >= 8 && seed->getLength() <= capacity) {
+        memcpy(out, seed->getBytesNoCopy(), seed->getLength());
+        for (unsigned index = 0; index < seed->getLength(); ++index) {
+            if (out[index]) { copied = seed->getLength(); break; }
+        }
+    }
+    node->release();
+    return copied;
+}
