+bool pmbRead(const ButtonState &b, uint16_t apid, uint16_t addr, uint8_t &out, uint32_t &status) {
+    const uint32_t channel = PMB_CHANNEL(apid);
+    wr32(b.obs.va, channel + PMB_REG_CMD, pmb_read_cmd(addr));
+    for (unsigned i = 0; i < 200; i++) {
+        status = rd32(b.obs.va, channel + PMB_REG_STATUS);
+        if (status & PMB_STATUS_DONE) {
+            if (status & PMB_STATUS_ERRORS) return false;
+            out = static_cast<uint8_t>(rd32(b.obs.va, channel + PMB_REG_RDATA0));
+            return true;
+        }
+        ioDelayUs(nullptr, 1);
+    }
+    return false;
